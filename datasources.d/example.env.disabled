# ---------------------------------------------------------------------------
# Datasource file TEMPLATE.
#
# This file is named `.env.disabled`, not `.env`, so the loader does NOT read it —
# only `*.env` files in this directory are loaded. Copy it to `<name>.env` to add a
# real datasource:
#
#     cp datasources.d/example.env.disabled datasources.d/warehouse.env
#     chmod 600 datasources.d/warehouse.env
#     # edit the values, then reload:
#     kill -HUP $(pgrep -f dist/server.js)
#
# THE FILENAME IS THE DATASOURCE NAME. `warehouse.env` defines a datasource called
# "warehouse"; there is no NAME key. The stem must match /^[a-z0-9_-]+$/.
#
# MODE 600 IS ENFORCED, not advisory. The loader refuses to read a file that is
# group- or other-readable and names the chmod fix. There is no CLI to set the mode
# for you, so this check is the only thing standing between a default-umask file and
# a world-readable password.
#
# Keys are BARE here — no `DS_<NAME>_` prefix. They are normalized to the same
# `DS_<NAME>_*` keys `.env` uses, so every zod default and guard default behaves
# identically no matter which file a datasource came from. A key that is not a known
# datasource field is REJECTED: a stray `TOKENS=` in this file cannot widen anyone's
# grants. Token grants live in `.env` only.
# ---------------------------------------------------------------------------

HOST=warehouse.internal
PORT=5432
USER=agent_ro_pg
PASSWORD=
DATABASE=analytics

# Schema used when a caller does not name one.
DEFAULT_SCHEMA=public

# WRITABLE defaults to FALSE — here and from every other config source. This
# gateway is read-only by default; a datasource never becomes writable by
# omission, and only an exact "true" turns it on (a typo stays read-only).
# Writes additionally need a write-mode token AND readOnly:false per request.
# WRITABLE=true

# Optional tuning — omit to take the defaults.
# POOL_MAX=5
# STATEMENT_TIMEOUT_MS=10000
# IDLE_TIMEOUT_MS=10000
# CONNECTION_TIMEOUT_MS=5000
# MAX_USES=7500
# SSL=false

# Relations this datasource must never expose, as `table` or `schema.table`.
# DENIED_TABLES=billing_accounts,public.api_keys

# Built-in sensitive-relation denylist. Secure-by-default: only an explicit
# false/0/no/off turns it off, so a typo keeps the safety net ON.
# SENSITIVE_RELATION_DENYLIST=true

# Escape hatch — skips the statement guard AND the relation guard for this
# datasource. Only for a datasource pointing at a trusted, restricted DB role.
# ALLOW_UNSAFE_STATEMENTS=false
