# ===========================================================================
# SAMPLE .env for a dev / uat / staging deployment
#
#   cp .env.multi.example .env      # then fill in the values below
#
# THE DATASOURCES ARE NOT IN THIS FILE. They live one-per-file in
# `datasources.d/`, which is what the `multi-datasource-runtime` feature on
# this branch exists to provide:
#
#   datasources.d/dev.env       (mode 600)  →  datasource "dev"
#   datasources.d/uat.env       (mode 600)  →  datasource "uat"
#   datasources.d/staging.env   (mode 600)  →  datasource "staging"
#
# Templates for all three are in that directory as `<name>.env.disabled`.
# Fill one in, `chmod 600`, drop the `.disabled`, and SIGHUP — no restart.
#
# Why not three DS_* blocks in here instead (which also works):
#   - a cluster you cannot currently reach is WITHHELD on reload, where at
#     BOOT a single unreachable datasource `exit(1)`s the whole gateway
#     (src/server.ts:36, src/mcp/mcp-server.ts:48). uat behind a down VPN
#     should not take dev with it.
#   - three passwords stop sharing a file with every token secret, at
#     enforced mode 600. This file can stay 644.
#   - `datasources.d/*` is already git-ignored; `.env` patterns match on
#     basename and would not have covered `dev.env`.
#
# ── FILL-IN ORDER MATTERS ─────────────────────────────────────────────────
# A token may only name a datasource that exists: `TOKEN_<ID>_DATASOURCES`
# referencing an unknown name is a hard boot failure (load-config.ts:194),
# and a config with NO datasource at all fails zod's `min(1)`. So:
#
#   1. activate at least one datasources.d/<name>.env
#   2. THEN put its name in TOKEN_AGENT_RO_DATASOURCES below
#
# Staging in one at a time? Set TOKEN_AGENT_RO_DATASOURCES=* until all three
# files are live, then narrow it to the explicit list.
#
# ── `#` IN A VALUE ────────────────────────────────────────────────────────
# This file is parsed by `node --env-file` at boot, and node truncates an
# unquoted value at the first `#`. QUOTE anything containing one:
#   TOKEN_AGENT_RO_SECRET="s3cr3t#value"
# (`datasources.d/*.env` is the opposite — `#` is literal there, so comments
# in those files must be on their own line.)
# ===========================================================================


# ── server (boot-only: a SIGHUP reload WARNS about these, never applies) ───
PORT=3200
# Loopback only. This process holds live DB credentials and the only barrier in
# front of them over HTTP is the plaintext bearer below, so a non-loopback bind
# is refused unless ALLOW_PUBLIC_BIND=true (an EMPTY value binds every
# interface and is refused too).
HOST=127.0.0.1
# ALLOW_PUBLIC_BIND=true
LOG_LEVEL=info

# Absolute hard cap, applied on top of any per-datasource / per-request value.
MAX_ROWS_CEILING=10000

# How stale a /health result may be, in ms (default 5000; 0 = re-ping always).
# HEALTH_CACHE_TTL_MS=5000

# Where the per-datasource files live. Default is CWD-relative
# ./datasources.d; a MISSING directory is not an error.
# DATASOURCES_DIR=./datasources.d


# ===========================================================================
# datasources
#
# Deliberately absent. Do NOT add `DATASOURCES=` or `DS_DEV_*` blocks here for
# dev/uat/staging — a name defined in BOTH `.env` and `datasources.d/` refuses
# the WHOLE reload rather than silently overriding a credential
# (config-sources.ts:133).
#
# `.env` DS_* blocks remain fully supported for datasources you want pinned to
# this file; see `.env.example` for that shape. Just don't define the same
# name twice.
# ===========================================================================


# ===========================================================================
# access tokens — this file is their ONLY home
#
#   *_SECRET      : the bearer value; rotate with `openssl rand -base64 24`
#   *_DATASOURCES : comma list of allowed logical names, or *
#   *_MODE        : read | write   (write implies read; read can never write)
#   *_SCHEMAS     : comma list of allowed schema names, or * for any
#                   non-system schema
#
# A datasource file cannot set these: unknown keys are rejected there, so a
# stray TOKENS= in `datasources.d/` can never widen anyone's grants.
#
# Token grants ARE re-read on SIGHUP, so scoping a token to a newly added
# datasource needs no restart.
# ===========================================================================
TOKENS=agent_ro

# ONE read-only identity spanning all three environments. This is the shape MCP
# needs: MCP_TOKEN resolves to exactly one token, and that single capability
# set is what every tool call runs under — so an MCP process can only reach the
# datasources named on the one token it authenticates as. Three per-env tokens
# would mean three MCP processes.
#
# Until all three files are live, use `*` here (see FILL-IN ORDER above).
TOKEN_AGENT_RO_SECRET=change-me-agent-ro
TOKEN_AGENT_RO_DATASOURCES=dev,uat,staging
TOKEN_AGENT_RO_MODE=read
TOKEN_AGENT_RO_SCHEMAS=*

# ── alternative: one least-privilege token per environment (HTTP callers) ──
# Prefer this when the callers are separate HTTP clients rather than one MCP
# process — a leaked dev secret then cannot read uat or staging. Add the ids
# to TOKENS above: TOKENS=agent_dev,agent_uat,agent_staging
#
# TOKEN_AGENT_DEV_SECRET=change-me-agent-dev
# TOKEN_AGENT_DEV_DATASOURCES=dev
# TOKEN_AGENT_DEV_MODE=read
# TOKEN_AGENT_DEV_SCHEMAS=*
#
# TOKEN_AGENT_UAT_SECRET=change-me-agent-uat
# TOKEN_AGENT_UAT_DATASOURCES=uat
# TOKEN_AGENT_UAT_MODE=read
# TOKEN_AGENT_UAT_SCHEMAS=public
#
# TOKEN_AGENT_STAGING_SECRET=change-me-agent-staging
# TOKEN_AGENT_STAGING_DATASOURCES=staging
# TOKEN_AGENT_STAGING_MODE=read
# TOKEN_AGENT_STAGING_SCHEMAS=public

# ── a write-capable token, DELIBERATELY COMMENTED OUT ─────────────────────
# No write token exists out of the box. Writes need THREE independent opt-ins,
# none of them on by default:
#   1. add `svc_dev_rw` to TOKENS above and uncomment this block
#   2. set WRITABLE=true in datasources.d/dev.env
#   3. pass readOnly:false on each write request
# Scope it to dev only. Its DB role must actually be able to write, so boot
# reports that datasource's posture as WEAK — expected and correct here.
# TOKEN_SVC_DEV_RW_SECRET=change-me-svc-dev-rw
# TOKEN_SVC_DEV_RW_DATASOURCES=dev
# TOKEN_SVC_DEV_RW_MODE=write
# TOKEN_SVC_DEV_RW_SCHEMAS=public


# ===========================================================================
# MCP transport (npm run start:mcp / start:mcp:http)
# ===========================================================================
# The bearer secret this MCP process runs AS — the raw secret, no "Bearer "
# prefix. It must match one TOKEN_*_SECRET above exactly or the process
# refuses to start, and that token's capabilities become the process's.
#
# A reload that would REMOVE this token — or merely ROTATE its secret — is
# refused outright, because the process would be left unable to authorize its
# own tool calls. Rotate it with a restart, not a SIGHUP.
# MCP_TOKEN=change-me-agent-ro
# stdio (default) or http
# MCP_TRANSPORT=http
# MCP_HTTP_PORT=3201
# Loopback only, same bind guard as HOST above.
# MCP_HTTP_HOST=127.0.0.1


# ===========================================================================
# adding, changing and removing a datasource at runtime
#
#   kill -HUP $(pgrep -f dist/server.js)          # HTTP gateway
#   kill -HUP $(pgrep -f dist/mcp/mcp-server.js)  # MCP (stdio)
#
# An agent already connected over MCP sees a new datasource by calling
# `list_datasources` again — no reconnecting /mcp.
#
# Stage 1 (permissions, parse, zod, name collision, MCP identity) is
# all-or-nothing: any failure leaves the running config bit-for-bit unchanged.
# Stage 2 (one ping + one posture probe per added/changed datasource) degrades
# per datasource, with three outcomes that mean DIFFERENT things:
#
#   withheld           NOT serving      — built but never published
#   retainedPrevious   serving, OLD cfg — the change could not be applied
#   postureUnverified  serving, NEW cfg — live, posture unestablished
#
# Watch `retainedPrevious`: change detection is a full config compare but the
# gate before a swap is a network SELECT 1, so a policy-only TIGHTENING
# (adding DENIED_TABLES, revoking WRITABLE) can fail on a transient blip and
# the LOOSER previous policy stays live. Retried on the next reload.
#
# `ok: true` means stage 1 passed and the diff applied — NOT that every
# datasource succeeded. Automation must read the outcome lists.
#
# Boot-only keys (PORT, HOST, LOG_LEVEL, MAX_ROWS_CEILING,
# HEALTH_CACHE_TTL_MS, ALLOW_PUBLIC_BIND, MCP_*, DATASOURCES_DIR) are compared
# and WARNED about, never applied silently. Restart to change one.
#
# Known limitation: a key DELETED from this file since boot is not unset by a
# reload — node loaded it into the environment at boot and that value survives.
# Changing a value works; removing one entirely needs a restart.
#
# Windows: SIGHUP is not deliverable. Restart instead; the directory format
# works unchanged.
# ===========================================================================
