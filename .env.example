# ── server ──
PORT=3200
# Loopback by default. This process holds live DB credentials, and over HTTP the only
# barrier in front of them is the plaintext bearer below — so ONLY loopback binds at
# startup; anything else is refused unless ALLOW_PUBLIC_BIND=true. Set that only with
# TLS termination and a rotated secret. Note an EMPTY value here binds every interface,
# which is why it is refused too. Applies to the MCP HTTP transport as well
# (MCP_HTTP_HOST, also 127.0.0.1 by default).
HOST=127.0.0.1
# ALLOW_PUBLIC_BIND=true
LOG_LEVEL=info

# Absolute hard caps (apply on top of any per-datasource / per-request value)
MAX_ROWS_CEILING=10000

# ── datasources (comma-separated logical names) ──
DATASOURCES=main

# These three double as the local Postgres container's credentials: docker-compose.yml
# maps DS_MAIN_USER/_PASSWORD/_DATABASE onto POSTGRES_USER/_PASSWORD/_DB, and
# publishes DS_MAIN_PORT on 127.0.0.1 — so `DS_MAIN_HOST=localhost` is the only
# change needed to point the gateway at it. See README → Local Postgres.
DS_MAIN_HOST=localhost
DS_MAIN_PORT=5432
# Point this at a READ-ONLY Postgres login role (see README → "The read-only guarantee
# lives in the database"). The DB grants — not TOKEN_*_MODE — are the real write barrier;
# a read-mode token in front of a write-capable role means app code is the only thing
# stopping a write. Recommended: agent_ro_pg (GRANT pg_read_all_data + read-only default
# txn). Creating the role is a USER action; every boot logs whether it worked.
DS_MAIN_USER=agent_ro_pg
DS_MAIN_PASSWORD=change-me-db-password
DS_MAIN_DATABASE=appdb
DS_MAIN_SSL=false
DS_MAIN_DEFAULT_SCHEMA=public
DS_MAIN_POOL_MAX=5
DS_MAIN_STATEMENT_TIMEOUT_MS=10000
DS_MAIN_IDLE_TIMEOUT_MS=10000
DS_MAIN_CONNECTION_TIMEOUT_MS=5000
DS_MAIN_MAX_USES=7500
# Datasource-level write gate — the THIRD gate, after TOKEN_*_MODE=write and an explicit
# readOnly:false on the request. A write reaching a non-writable datasource is a 403
# before any DB contact, whatever the token says.
#
# DEFAULTS TO FALSE, from EVERY config source (.env, datasources.d/, DATABASE_*). This
# gateway is read-only by default and a datasource never becomes writable by omission.
# Opt-IN semantics: only an exact "true" grants it, so a typo stays read-only. Boot logs
# a WARN naming every datasource for which this is on.
# DS_MAIN_WRITABLE=true
# Statement/relation guard escape hatch. Default (unset/false) = the guards are ENFORCED:
# a read/write call may only run allowlisted statements (SELECT/WITH/EXPLAIN/VALUES/TABLE,
# plus INSERT/UPDATE/DELETE/MERGE for write tokens; SHOW is NOT allowed), may NOT call
# side-effecting functions (COPY, pg_read_file, pg_terminate_backend, dblink, …), and may
# NOT read catalog/information_schema relations or denied tables (see DENIED_TABLES below).
# Set to true ONLY for a datasource whose DB role you fully trust and which must run
# admin/COPY/file/catalog statements — it removes BOTH guard layers and boot logs a WARN.
# Fail-closed: any non-"true" value (incl. garbage) leaves the guards enforced.
# DS_MAIN_ALLOW_UNSAFE_STATEMENTS=false

# Relation denylist enforced by the relation guard: any query whose parse tree references
# one of these relations is rejected (400) before DB contact. Entries are `table` (matches
# in ANY schema) or `schema.table` (exact); case-insensitive. Default is EMPTY — the
# gateway is generic, so deployments declare their own list. Skipped when
# DS_MAIN_ALLOW_UNSAFE_STATEMENTS=true. The list below is the MDS identity/secrets set
# (verified against the live DB 2026-08-03).
DS_MAIN_DENIED_TABLES=user,user_login_session,user_settings,account_user,role,role_subscriptions,stage_roles,stage_role_access_controls,stage_access_controls,workspace_access_controls,data_register_access_controls,system_settings,env_dump,pg_rce_out

# Built-in secure-by-default sensitive-relation denylist (name-pattern match for
# secret/credential/token/key stores: secrets, api_keys, oauth_tokens, private_keys,
# recovery_codes, mfa_secrets, vault, …). Merged with DENIED_TABLES above and enforced
# even when it is empty. Default TRUE. Set false to rely on DENIED_TABLES alone (e.g. if
# it false-positives a legit table like client_secrets). Skipped by ALLOW_UNSAFE_STATEMENTS.
# DS_MAIN_SENSITIVE_RELATION_DENYLIST=true

# ── additional datasources without editing this file ──
# A datasource may instead live in its own file under `datasources.d/<name>.env`, where
# the FILENAME is the datasource name and keys are BARE (HOST=, USER=, … — no DS_<NAME>_
# prefix). Those files must be mode 600; the loader refuses to read them otherwise.
# See datasources.d/example.env.disabled for the full template.
#
# Semantics are IDENTICAL to a datasource defined here — same keys, same defaults,
# WRITABLE fails closed in both places. One extra restriction applies there:
#   - only datasource keys are accepted — a stray TOKENS= is rejected, so a datasource
#     file can never widen anyone's grants
#
# Both sources are re-read on SIGHUP, so a datasource can be added, changed or removed
# without a restart:  kill -HUP $(pgrep -f dist/server.js)
# TOKENS and the boot-only keys (PORT, HOST, LOG_LEVEL, MAX_ROWS_CEILING, …) live in THIS
# file only. Token grants are re-read on reload; boot-only keys warn that a restart is
# required rather than being applied silently. A name defined in BOTH sources refuses the
# whole reload — a credential is never silently overridden.
# DATASOURCES_DIR=./datasources.d

# ── fallback ──
# If NO DS_* datasource is configured, a single "main" datasource is
# seeded from the canonical DATABASE_* vars below (drops into the
# existing stack with zero new config). Ignored when DS_* are present.
# DATABASE_HOST=localhost
# DATABASE_PORT=5432
# DATABASE_USERNAME=postgres
# DATABASE_PASSWORD=postgres
# DATABASE_NAME=appdb
# DATABASE_SSL=false
# DATABASE_ALLOW_UNSAFE_STATEMENTS=false
# DATABASE_DENIED_TABLES=user,role,system_settings,env_dump,pg_rce_out

# ── access tokens (comma-separated ids) ──
# NOTE: no write-capable token is configured out of the box. Writes need THREE
# independent opt-ins — a write-mode token, DS_<NAME>_WRITABLE=true, and readOnly:false
# on the request — and none of them is on by default.
TOKENS=agent_ro

# token → secret + capabilities.
#   *_DATASOURCES : comma list of allowed logical datasource names (or *)
#   *_MODE        : read | write   (write also allows read; read can never write)
#   *_SCHEMAS     : comma list of allowed schema names (or * for any non-system schema)
# Rotate secrets with `openssl rand -base64 24`; update MCP_TOKEN to match (README →
# "Rotating the bearer secret"). MODE is a routing/UX control, NOT the write barrier.
TOKEN_AGENT_RO_SECRET=change-me-agent-ro
TOKEN_AGENT_RO_DATASOURCES=main
TOKEN_AGENT_RO_MODE=read
TOKEN_AGENT_RO_SCHEMAS=*

# A write-capable token, DELIBERATELY COMMENTED OUT. To enable writes you must:
#   1. add `svc_rw` to TOKENS above
#   2. uncomment this block
#   3. set DS_<NAME>_WRITABLE=true on the datasource it should reach
#   4. pass readOnly:false on each write request
# Point it at a datasource whose DB role can actually write; boot will report the
# posture as WEAK, which is expected and correct for a genuine write datasource.
# TOKEN_SVC_RW_SECRET=change-me-svc-rw
# TOKEN_SVC_RW_DATASOURCES=main
# TOKEN_SVC_RW_MODE=write
# TOKEN_SVC_RW_SCHEMAS=public
